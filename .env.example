# Cadena de conexión de PostgreSQL (Neon, Supabase, Railway, Render, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=public"

# URL base de la app (en local no cambia)
NEXTAUTH_URL="http://localhost:3000"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"

# Credenciales de tu GitHub OAuth App (https://github.com/settings/developers)
GITHUB_ID="tu-client-id"
GITHUB_SECRET="tu-client-secret"
